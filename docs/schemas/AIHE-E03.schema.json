{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-healthcare-economics.github.io/AIHE_Canon_V1.0/schemas/AIHE-E03.schema.json",
  "title": "AIHE-E03 — Supported Asset-Life Decision Record",
  "description": "Compare maintain, refurbish, replace, and shared-service options across suitability, life, cost, resources, resilience, and disposition.",
  "type": "object",
  "properties": {
    "resource_id": {
      "const": "AIHE-E03"
    },
    "record_version": {
      "type": "string"
    },
    "system_version": {
      "type": "string"
    },
    "evidence_cut_off": {
      "type": "string"
    },
    "accountable_owner": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision_factor": {
            "type": "string",
            "title": "Decision factor"
          },
          "maintain_or_repair": {
            "type": "string",
            "title": "Maintain or repair"
          },
          "refurbish_or_remanufacture": {
            "type": "string",
            "title": "Refurbish or remanufacture"
          },
          "replace": {
            "type": "string",
            "title": "Replace"
          },
          "shared_service": {
            "type": "string",
            "title": "Shared service"
          },
          "evidence_uncertainty_and_decision": {
            "type": "string",
            "title": "Evidence, uncertainty, and decision"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "required": [
    "resource_id",
    "records"
  ],
  "additionalProperties": true,
  "x-column-map": {
    "Decision factor": "decision_factor",
    "Maintain or repair": "maintain_or_repair",
    "Refurbish or remanufacture": "refurbish_or_remanufacture",
    "Replace": "replace",
    "Shared service": "shared_service",
