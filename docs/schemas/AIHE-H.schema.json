{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-healthcare-management-economics.github.io/digital-resource-companion/schemas/AIHE-H.schema.json",
  "title": "AI Project One-Page Decision Memo",
  "description": "Structured exchange schema for this companion resource. Do not store identifiable patient information.",
  "type": "object",
  "properties": {
    "resource_id": {
      "const": "AIHE-H"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Resource version, retained with the exported record."
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "synthetic_example": {
      "type": "boolean"
    },
    "sections": {
      "type": "object",
      "properties": {
        "Main": {
          "type": "object",
          "properties": {
            "paragraphs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tables": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "integer"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Memo section": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Memo section"
                          },
                          "Content to include": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Content to include"
                          }
                        },
                        "required": [
                          "Memo section",
                          "Content to include"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "table",
                    "rows"
                  ],
                  "additionalProperties": false
                }
              ],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "paragraphs",
            "tables"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "Main"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "resource_id",
    "title",
    "version",
    "last_reviewed",
    "synthetic_example",
    "sections"
  ],
  "additionalProperties": false
}
