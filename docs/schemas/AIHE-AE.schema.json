{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-HED Completeness and Decision-Quality Review",
  "type": "object",
  "required": [
    "resource_id",
    "version",
    "record"
  ],
  "properties": {
    "resource_id": {
      "const": "AIHE-AE"
    },
    "version": "V1.0",
    "current_printed_location": {
      "type": "string"
    },
    "record": {
      "type": "object",
      "properties": {
        "decision_problem": {
          "type": "string"
        },
        "data_readiness": {
          "type": "string"
        },
        "evidence_validation": {
          "type": "string"
        },
        "economic_analysis": {
          "type": "string"
        },
        "governance_risk": {
          "type": "string"
        },
        "procurement_contract": {
          "type": "string"
        },
        "implementation": {
          "type": "string"
        },
        "monitoring_lifecycle": {
          "type": "string"
        },
        "decision_record": {
          "type": "string"
        }
      }
    }
  }
}
