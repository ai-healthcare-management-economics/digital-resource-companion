{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/AIHE-E.schema.json",
  "title": "Applied Case and Decision Review Template",
  "description": "Structured exchange schema for this companion resource. Do not store identifiable patient information.",
  "type": "object",
  "properties": {
    "resource_id": {
      "const": "AIHE-E"
    },
    "title": {
      "type": "string"
    },
    "version": "V1.0",
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "synthetic_example": {
      "type": "boolean"
    },
    "sections": {
      "type": "object",
      "properties": {
        "Main": {
          "type": "object",
          "properties": {
            "paragraphs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tables": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "integer"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Case element": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Case element"
                          },
                          "Prompt": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Prompt"
                          }
                        },
                        "required": [
                          "Case element",
                          "Prompt"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "table",
                    "rows"
                  ],
                  "additionalProperties": false
                }
              ],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "paragraphs",
            "tables"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "Main"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "resource_id",
    "title",
    "version",
    "last_reviewed",
    "synthetic_example",
    "sections"
  ],
  "additionalProperties": false
}
