{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/AIHE-L.schema.json",
  "title": "Health-System AI Readiness Maturity Assessment",
  "description": "Structured exchange schema for this companion resource. Do not store identifiable patient information.",
  "type": "object",
  "properties": {
    "resource_id": {
      "const": "AIHE-L"
    },
    "title": {
      "type": "string"
    },
    "version": "V1.0",
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "synthetic_example": {
      "type": "boolean"
    },
    "sections": {
      "type": "object",
      "properties": {
        "Main": {
          "type": "object",
          "properties": {
            "paragraphs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tables": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "integer"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Domain": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Domain"
                          },
                          "1 Fragmented": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "1 Fragmented"
                          },
                          "2 Digitized": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "2 Digitized"
                          },
                          "3 Data-driven": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "3 Data-driven"
                          },
                          "4 AI-assisted": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "4 AI-assisted"
                          },
                          "5 Learning AI-enabled": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "5 Learning AI-enabled"
                          },
                          "Evidence / priority": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Evidence / priority"
                          }
                        },
                        "required": [
                          "Domain",
                          "1 Fragmented",
                          "2 Digitized",
                          "3 Data-driven",
                          "4 AI-assisted",
                          "5 Learning AI-enabled",
                          "Evidence / priority"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "table",
                    "rows"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "integer"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Field": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Field"
                          },
                          "Guidance / response": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Guidance / response"
                          }
                        },
                        "required": [
                          "Field",
                          "Guidance / response"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "table",
                    "rows"
                  ],
                  "additionalProperties": false
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "paragraphs",
            "tables"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "Main"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "resource_id",
    "title",
    "version",
    "last_reviewed",
    "synthetic_example",
    "sections"
  ],
  "additionalProperties": false
}
