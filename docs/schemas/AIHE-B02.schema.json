{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-healthcare-management-economics.github.io/digital-resource-companion/schemas/AIHE-B02.schema.json",
  "title": "AIHE-B02 — Lifecycle Cost and Pricing Record",
  "description": "Record acquisition through exit costs, resource use, pricing exposure, opportunity cost, residual value, and evidence.",
  "type": "object",
  "properties": {
    "resource_id": {
      "const": "AIHE-B02"
    },
    "record_version": {
      "type": "string"
    },
    "system_version": {
      "type": "string"
    },
    "evidence_cut_off": {
      "type": "string"
    },
    "accountable_owner": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cost_layer": {
            "type": "string",
            "title": "Cost layer"
          },
          "resource_or_pricing_unit": {
            "type": "string",
            "title": "Resource or pricing unit"
          },
          "quantity": {
            "type": "string",
            "title": "Quantity"
          },
          "unit_cost": {
            "type": "string",
            "title": "Unit cost"
          },
          "year_s": {
            "type": "string",
            "title": "Year(s)"
          },
          "low": {
            "type": "string",
            "title": "Low"
          },
          "high": {
            "type": "string",
            "title": "High"
          },
          "budget_owner": {
            "type": "string",
            "title": "Budget owner"
          },
          "evidence_and_notes": {
            "type": "string",
            "title": "Evidence and notes"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "required": [
    "resource_id",
    "records"
  ],
  "additionalProperties": true,
  "x-column-map": {
    "Cost layer": "cost_layer",
    "Resource or pricing unit": "resource_or_pricing_unit",
    "Quantity": "quantity",
    "Unit cost": "unit_cost",
    "Year(s)": "year_s",
    "Low": "low",
    "High": "high",
    "Budget owner": "budget_owner",
    "Evidence and notes": "evidence_and_notes"
  },
  "x-resource-version": "V1.0"
}
