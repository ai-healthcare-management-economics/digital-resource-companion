{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-healthcare-economics.github.io/AIHE_Canon_V1.0/schemas/AIHE-B05.schema.json",
  "title": "AIHE-B05 — Model Selection, Uncertainty, and Reproducibility",
  "description": "Select a decision model from the problem structure and document evidence, verification, uncertainty, and reproducibility.",
  "type": "object",
  "properties": {
    "resource_id": {
      "const": "AIHE-B05"
    },
    "record_version": {
      "type": "string"
    },
    "system_version": {
      "type": "string"
    },
    "evidence_cut_off": {
      "type": "string"
    },
    "accountable_owner": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision_structure": {
            "type": "string",
            "title": "Decision structure"
          },
          "candidate_approach": {
            "type": "string",
            "title": "Candidate approach"
          },
          "critical_evidence": {
            "type": "string",
            "title": "Critical evidence"
          },
          "verification_and_uncertainty_record": {
            "type": "string",
            "title": "Verification and uncertainty record"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "required": [
    "resource_id",
    "records"
  ],
  "additionalProperties": true,
  "x-column-map": {
    "Decision structure": "decision_structure",
    "Candidate approach": "candidate_approach",
    "Critical evidence": "critical_evidence",
    "Verification and uncertainty record": "verification_and_uncertainty_record"
  },
  "x-resource-version": "V1.0"
}
