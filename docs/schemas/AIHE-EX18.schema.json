{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HTA, Reimbursement, and Adoption Record",
  "type": "object",
  "properties": {
    "decision_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Decision layer": {
            "type": "string"
          },
          "Decision and authority": {
            "type": "string"
          },
          "Evidence required or available": {
            "type": "string"
          },
          "Gap, condition, or next action": {
            "type": "string"
          }
        }
      }
    }
  }
}
