{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Material Change and Renewal Review",
  "type": "object",
  "required": [
    "resource_id",
    "version",
    "record"
  ],
  "properties": {
    "resource_id": {
      "const": "AIHE-EX11"
    },
    "version": "V1.0",
    "current_printed_location": {
      "type": "string"
    },
    "record": {
      "type": "object",
      "properties": {
        "change_domain": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "required_evidence": {
          "type": "string"
        },
        "owner_due": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "annual_renewal": {
          "type": "string"
        }
      }
    }
  }
}
