  "additionalProperties": true,
  "x-column-map": {
    "Strategy or domain": "strategy_or_domain",
    "Decision question and evidence": "decision_question_and_evidence",
    "Expected value and burden": "expected_value_and_burden",
    "Constraint, action, owner, and measure": "constraint_action_owner_and_measure"
