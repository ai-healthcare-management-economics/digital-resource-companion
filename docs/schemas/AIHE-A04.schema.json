{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-healthcare-management-economics.github.io/digital-resource-companion/schemas/AIHE-A04.schema.json",
  "title": "AIHE-A04 — Data Source, Provenance, and Fitness Record",
  "description": "Document source and derived data assets, authority, definitions, transformations, quality, lineage, monitoring, and remediation.",
  "type": "object",
  "properties": {
    "resource_id": {
      "const": "AIHE-A04"
    },
    "record_version": {
      "type": "string"
    },
    "system_version": {
      "type": "string"
    },
    "evidence_cut_off": {
      "type": "string"
    },
    "accountable_owner": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_or_derived_asset": {
            "type": "string",
            "title": "Source or derived asset"
          },
          "purpose_and_required_timing": {
            "type": "string",
            "title": "Purpose and required timing"
          },
          "authority_and_steward": {
            "type": "string",
            "title": "Authority and steward"
          },
          "definition_units_and_transformations": {
            "type": "string",
            "title": "Definition, units, and transformations"
          },
          "completeness_plausibility_and_representativeness": {
            "type": "string",
            "title": "Completeness, plausibility, and representativeness"
          },
          "lineage_version_and_monitoring": {
            "type": "string",
            "title": "Lineage, version, and monitoring"
          },
          "risk_remediation_and_decision": {
            "type": "string",
            "title": "Risk, remediation, and decision"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "required": [
    "resource_id",
    "records"
  ],
  "additionalProperties": true,
  "x-column-map": {
    "Source or derived asset": "source_or_derived_asset",
    "Purpose and required timing": "purpose_and_required_timing",
    "Authority and steward": "authority_and_steward",
    "Definition, units, and transformations": "definition_units_and_transformations",
    "Completeness, plausibility, and representativeness": "completeness_plausibility_and_representativeness",
    "Lineage, version, and monitoring": "lineage_version_and_monitoring",
    "Risk, remediation, and decision": "risk_remediation_and_decision"
  },
  "x-resource-version": "V1.0"
}
