            "type": "string",
            "title": "Owner and timing"
          },
          "review_burden_conversion_condition_and_realized_result": {
            "type": "string",
            "title": "Review burden, conversion condition, and realized result"
          }
        },
        "additionalProperties": true
      }
    }
