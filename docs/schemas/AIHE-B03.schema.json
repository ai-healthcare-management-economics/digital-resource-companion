{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-healthcare-management-economics.github.io/digital-resource-companion/schemas/AIHE-B03.schema.json",
  "title": "AIHE-B03 — Benefit Realization and Capacity Conversion",
  "description": "Translate claimed benefits into measurable mechanisms, owners, baselines, conversion conditions, and realized results.",
  "type": "object",
  "properties": {
    "resource_id": {
      "const": "AIHE-B03"
