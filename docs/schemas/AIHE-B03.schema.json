    "record_version": {
      "type": "string"
    },
    "system_version": {
      "type": "string"
    },
    "evidence_cut_off": {
      "type": "string"
    },
    "accountable_owner": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claimed_benefit": {
            "type": "string",
