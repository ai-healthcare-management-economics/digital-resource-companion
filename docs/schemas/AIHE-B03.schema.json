  "required": [
    "resource_id",
    "records"
  ],
  "additionalProperties": true,
  "x-column-map": {
    "Claimed benefit": "claimed_benefit",
    "Causal mechanism and comparator": "causal_mechanism_and_comparator",
    "Measure, baseline, and evidence": "measure_baseline_and_evidence",
    "Owner and timing": "owner_and_timing",
    "Review burden, conversion condition, and realized result": "review_burden_conversion_condition_and_realized_result"
