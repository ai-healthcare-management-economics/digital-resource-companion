{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analytic and Simulation Method Selection Guide",
  "type": "object",
  "required": [
    "resource_id",
    "version",
    "record"
  ],
  "properties": {
    "resource_id": {
      "const": "AIHE-EX15"
    },
    "version": "V1.0",
    "current_printed_location": {
      "type": "string"
    },
    "record": {
      "type": "object",
      "properties": {
        "decision_problem": {
          "type": "string"
        },
        "time_structure": {
          "type": "string"
        },
        "unit_of_analysis": {
          "type": "string"
        },
        "recurrence": {
          "type": "string"
        },
        "heterogeneity": {
          "type": "string"
        },
        "queues_resources": {
          "type": "string"
        },
        "feedback_interaction": {
          "type": "string"
        },
        "selected_method": {
          "type": "string"
        },
        "rejected_alternatives": {
          "type": "string"
        },
        "validation_plan": {
          "type": "string"
        },
        "decision_output": {
          "type": "string"
        }
      }
    }
  }
}
