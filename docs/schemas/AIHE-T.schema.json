{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/AIHE-T.schema.json",
  "title": "AI De-adoption and Decommissioning Plan",
  "description": "Structured exchange schema for this companion resource. Do not store identifiable patient information.",
  "type": "object",
  "properties": {
    "resource_id": {
      "const": "AIHE-T"
    },
    "title": {
      "type": "string"
    },
    "version": "V1.0",
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "synthetic_example": {
      "type": "boolean"
    },
    "sections": {
      "type": "object",
      "properties": {
        "Main": {
          "type": "object",
          "properties": {
            "paragraphs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tables": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "integer"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Trigger domain": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Trigger domain"
                          },
                          "Indicator / event": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Indicator / event"
                          },
                          "Threshold": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Threshold"
                          },
                          "Immediate action": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Immediate action"
                          },
                          "Review authority": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Review authority"
                          },
                          "Potential final action": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Potential final action"
                          }
                        },
                        "required": [
                          "Trigger domain",
                          "Indicator / event",
                          "Threshold",
                          "Immediate action",
                          "Review authority",
                          "Potential final action"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "table",
                    "rows"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "integer"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Exit workstream": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Exit workstream"
                          },
                          "Required action": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Required action"
                          },
                          "Owner": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Owner"
                          },
                          "Dependency": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Dependency"
                          },
                          "Deadline": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Deadline"
                          },
                          "Completion evidence": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Completion evidence"
                          }
                        },
                        "required": [
                          "Exit workstream",
                          "Required action",
                          "Owner",
                          "Dependency",
                          "Deadline",
                          "Completion evidence"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "table",
                    "rows"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "integer"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Field": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Field"
                          },
                          "Guidance / response": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Guidance / response"
                          }
                        },
                        "required": [
                          "Field",
                          "Guidance / response"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "table",
                    "rows"
                  ],
                  "additionalProperties": false
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "paragraphs",
            "tables"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "Main"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "resource_id",
    "title",
    "version",
    "last_reviewed",
    "synthetic_example",
    "sections"
  ],
  "additionalProperties": false
}
