{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reproducible Analysis, Model Risk, and Code Quality Checklist",
  "type": "object",
  "required": [
    "resource_id",
    "version",
    "record"
  ],
  "properties": {
    "resource_id": {
      "const": "AIHE-EX16"
    },
    "version": "V1.0",
    "current_printed_location": {
      "type": "string"
    },
    "record": {
      "type": "object",
      "properties": {
        "decision_specification": {
          "type": "string"
        },
        "data_provenance": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "version_control": {
          "type": "string"
        },
        "testing": {
          "type": "string"
        },
        "convergence": {
          "type": "string"
        },
        "verification_validation": {
          "type": "string"
        },
        "uncertainty": {
          "type": "string"
        },
        "privacy_security": {
          "type": "string"
        },
        "traceability": {
          "type": "string"
        },
        "release_archive": {
          "type": "string"
        }
      }
    }
  }
}
