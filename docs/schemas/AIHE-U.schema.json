{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/AIHE-U.schema.json",
  "title": "SHARE-AI Secondary-Use Governance Worksheet",
  "description": "Structured exchange schema for this companion resource. Do not store identifiable patient information.",
  "type": "object",
  "properties": {
    "resource_id": {
      "const": "AIHE-U"
    },
    "title": {
      "type": "string"
    },
    "version": "V1.0",
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "synthetic_example": {
      "type": "boolean"
    },
    "sections": {
      "type": "object",
      "properties": {
        "Main": {
          "type": "object",
          "properties": {
            "paragraphs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tables": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "integer"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Stage": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Stage"
                          },
                          "Required record": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Required record"
                          },
                          "Response / evidence": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Response / evidence"
                          },
                          "Owner": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Owner"
                          },
                          "Decision / condition": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Decision / condition"
                          }
                        },
                        "required": [
                          "Stage",
                          "Required record",
                          "Response / evidence",
                          "Owner",
                          "Decision / condition"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "table",
                    "rows"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "integer"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Data element / source": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Data element / source"
                          },
                          "Purpose necessity": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Purpose necessity"
                          },
                          "Identifiability": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Identifiability"
                          },
                          "Quality / missingness": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Quality / missingness"
                          },
                          "Access role": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Access role"
                          },
                          "Retention": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Retention"
                          },
                          "Transfer / linkage": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Transfer / linkage"
                          },
                          "Risk control": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Risk control"
                          }
                        },
                        "required": [
                          "Data element / source",
                          "Purpose necessity",
                          "Identifiability",
                          "Quality / missingness",
                          "Access role",
                          "Retention",
                          "Transfer / linkage",
                          "Risk control"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "table",
                    "rows"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "integer"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Question": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Question"
                          },
                          "Response": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "title": "Response"
                          }
                        },
                        "required": [
                          "Question",
                          "Response"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "table",
                    "rows"
                  ],
                  "additionalProperties": false
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "paragraphs",
            "tables"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "Main"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "resource_id",
    "title",
    "version",
    "last_reviewed",
    "synthetic_example",
    "sections"
  ],
  "additionalProperties": false
}
