{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Pricing and Contract Scenario Record",
  "type": "object",
  "required": [
    "resource_id",
    "version",
    "record"
  ],
  "properties": {
    "resource_id": {
      "const": "AIHE-EX17"
    },
    "version": "V1.0",
    "current_printed_location": {
      "type": "string"
    },
    "record": {
      "type": "object",
      "properties": {
        "base_fee": {
          "type": "string"
        },
        "variable_unit": {
          "type": "string"
        },
        "volume_bands": {
          "type": "string"
        },
        "expenditure_cap": {
          "type": "string"
        },
        "integration_support": {
          "type": "string"
        },
        "training": {
          "type": "string"
        },
        "monitoring_assurance": {
          "type": "string"
        },
        "updates": {
          "type": "string"
        },
        "indexation": {
          "type": "string"
        },
        "exit": {
          "type": "string"
        },
        "renewal_condition": {
          "type": "string"
        }
      }
    }
  }
}
