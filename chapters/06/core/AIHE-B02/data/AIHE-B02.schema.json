{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-healthcare-management-economics.github.io/digital-resource-companion/schemas/AIHE-B02.schema.json",
  "title": "AIHE-B02 — Lifecycle Cost and Pricing Record",
  "description": "Record acquisition through exit costs, resource use, pricing exposure, opportunity cost, residual value, and evidence. Schema validation checks record structure only; it does not establish evidence quality or institutional authorization.",
  "anyOf": [
    {
      "$ref": "#/$defs/canonical_record"
    },
    {
      "$ref": "#/$defs/browser_draft"
    }
  ],
  "$defs": {
    "canonical_record": {
      "type": "object",
      "required": [
        "metadata",
        "records"
      ],
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "resource_id": {
              "const": "AIHE-B02"
            },
            "resource_version": {
              "type": "string"
            },
            "release_date": {
              "type": "string"
            },
            "access_date": {
              "type": "string"
            },
            "evidence_cut_off": {
              "type": "string"
            },
            "local_modifications": {
              "type": "string"
            },
            "organization": {
              "type": "string"
            },
            "intervention": {
              "type": "string"
            },
            "intervention_version": {
              "type": "string"
            },
            "accountable_owner": {
              "type": "string"
            },
            "decision_authority": {
              "type": "string"
            },
            "next_review_date": {
              "type": "string"
            }
          },
          "required": [
            "resource_id"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "section",
              "field_or_question",
              "response_or_evidence"
            ],
            "properties": {
              "section": {
                "type": "string"
              },
              "field_or_question": {
                "type": "string"
              },
              "guidance": {
                "type": "string"
              },
              "response_or_evidence": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "due_or_review_date": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "browser_draft": {
      "title": "Browser drafting export",
      "type": "object",
      "required": [
        "resource_id",
        "title",
        "version",
        "exported_at",
        "records"
      ],
      "properties": {
        "resource_id": {
          "const": "AIHE-B02"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Lifecycle layer": {
                "type": "string"
              },
              "Resource or pricing unit": {
                "type": "string"
              },
              "Quantity": {
                "type": "string"
              },
              "Economic cost": {
                "type": "string"
              },
              "Cash expenditure": {
                "type": "string"
              },
              "Accounting expense": {
                "type": "string"
              },
              "Budget owner or incidence": {
                "type": "string"
              },
              "Timing or scenario": {
                "type": "string"
              },
              "Evidence, assumptions, and notes": {
                "type": "string"
              }
            },
            "required": [
              "Lifecycle layer",
              "Resource or pricing unit",
              "Quantity",
              "Economic cost",
              "Cash expenditure",
              "Accounting expense",
              "Budget owner or incidence",
              "Timing or scenario",
              "Evidence, assumptions, and notes"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  }
}
