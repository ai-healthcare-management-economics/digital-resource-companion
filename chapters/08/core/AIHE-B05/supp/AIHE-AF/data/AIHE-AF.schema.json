{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence, Reporting, and Assurance Crosswalk",
  "type": "object",
  "required": [
    "resource_id",
    "version",
    "record"
  ],
  "properties": {
    "resource_id": {
      "const": "AIHE-AF"
    },
    "version": {
      "type": "string",
      "description": "Resource version, retained with the exported record."
    },
    "current_printed_location": {
      "type": "string"
    },
    "record": {
      "type": "object",
      "properties": {
        "evidence_need": {
          "type": "string"
        },
        "standard_framework": {
          "type": "string"
        },
        "primary_purpose": {
          "type": "string"
        },
        "institutional_use": {
          "type": "string"
        },
        "version_review_action": {
          "type": "string"
        }
      }
    }
  },
  "$id": "https://ai-healthcare-management-economics.github.io/digital-resource-companion/schemas/AIHE-AF.schema.json"
}
