{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-healthcare-management-economics.github.io/digital-resource-companion/schemas/AIHE-A04.schema.json",
  "title": "AIHE-A04 — Data Source, Provenance, and Fitness Record",
  "description": "Document source and derived data assets, authority, definitions, transformations, quality, lineage, monitoring, and remediation. Schema validation checks record structure only; it does not establish evidence quality or institutional authorization.",
  "anyOf": [
    {
      "$ref": "#/$defs/canonical_record"
    },
    {
      "$ref": "#/$defs/browser_draft"
    }
  ],
  "$defs": {
    "canonical_record": {
      "type": "object",
      "required": [
        "metadata",
        "records"
      ],
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "resource_id": {
              "const": "AIHE-A04"
            },
            "resource_version": {
              "type": "string"
            },
            "release_date": {
              "type": "string"
            },
            "access_date": {
              "type": "string"
            },
            "evidence_cut_off": {
              "type": "string"
            },
            "local_modifications": {
              "type": "string"
            },
            "organization": {
              "type": "string"
            },
            "intervention": {
              "type": "string"
            },
            "intervention_version": {
              "type": "string"
            },
            "accountable_owner": {
              "type": "string"
            },
            "decision_authority": {
              "type": "string"
            },
            "next_review_date": {
              "type": "string"
            }
          },
          "required": [
            "resource_id"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "section",
              "field_or_question",
              "response_or_evidence"
            ],
            "properties": {
              "section": {
                "type": "string"
              },
              "field_or_question": {
                "type": "string"
              },
              "guidance": {
                "type": "string"
              },
              "response_or_evidence": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "due_or_review_date": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "browser_draft": {
      "title": "Browser drafting export",
      "type": "object",
      "required": [
        "resource_id",
        "title",
        "version",
        "exported_at",
        "records"
      ],
      "properties": {
        "resource_id": {
          "const": "AIHE-A04"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Source or derived asset": {
                "type": "string"
              },
              "Purpose and required timing": {
                "type": "string"
              },
              "Authority and steward": {
                "type": "string"
              },
              "Definition, units, and transformations": {
                "type": "string"
              },
              "Completeness, plausibility, and representativeness": {
                "type": "string"
              },
              "Lineage, version, and monitoring": {
                "type": "string"
              },
              "Risk, remediation, and decision": {
                "type": "string"
              }
            },
            "required": [
              "Source or derived asset",
              "Purpose and required timing",
              "Authority and steward",
              "Definition, units, and transformations",
              "Completeness, plausibility, and representativeness",
              "Lineage, version, and monitoring",
              "Risk, remediation, and decision"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  }
}
