{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incident Corrective Action and Reconstruction Log",
  "type": "object",
  "required": [
    "resource_id",
    "version",
    "record"
  ],
  "properties": {
    "resource_id": {
      "const": "AIHE-EX12"
    },
    "version": "V1.0",
    "current_printed_location": {
      "type": "string"
    },
    "record": {
      "type": "object",
      "properties": {
        "incident_identification": {
          "type": "string"
        },
        "categories": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "data_provenance": {
          "type": "string"
        },
        "model_configuration": {
          "type": "string"
        },
        "ai_output": {
          "type": "string"
        },
        "human_action": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "response": {
          "type": "string"
        },
        "cause": {
          "type": "string"
        },
        "corrective_action": {
          "type": "string"
        },
        "closure": {
          "type": "string"
        }
      }
    }
  }
}
