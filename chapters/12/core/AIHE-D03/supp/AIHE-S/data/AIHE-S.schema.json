{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Algorithmovigilance Dashboard, Cadence, and Incident Record",
  "type": "object",
  "required": [
    "resource_id",
    "version",
    "record"
  ],
  "properties": {
    "resource_id": {
      "const": "AIHE-S"
    },
    "version": {
      "type": "string",
      "description": "Resource version, retained with the exported record."
    },
    "current_printed_location": {
      "type": "string"
    },
    "record": {
      "type": "object",
      "properties": {
        "dashboard": {
          "type": "string"
        },
        "cadence": {
          "type": "string"
        },
        "incident_taxonomy": {
          "type": "string"
        },
        "incident_reconstruction": {
          "type": "string"
        },
        "escalation": {
          "type": "string"
        },
        "closure": {
          "type": "string"
        }
      }
    }
  },
  "$id": "https://ai-healthcare-management-economics.github.io/digital-resource-companion/schemas/AIHE-S.schema.json"
}
